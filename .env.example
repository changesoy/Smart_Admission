# Smart Admission Backend Lite 环境变量样例
#
# 用法: 复制为 .env 后填入真实值。.env 已加入 .gitignore，不要提交。
# 生产环境建议直接注入环境变量，而不是落地 .env 文件。

# 天地图搜索 token（服务端专用）
# 与前端 js/config.js 的瓦片 token 分离，不要复用同一个 token。
# 申请: https://console.tianditu.gov.cn/
TIANDITU_SEARCH_TK=

# 数据目录: 开发为 ./data，生产为 /workspace/data
DATA_DIR=./data

# 应用版本与构建时间
# 留空时 APP_VERSION 回退到 package.json 的 version，BUILD_TIME 上报 null
APP_VERSION=
BUILD_TIME=

# 搜索代理调优
SEARCH_TIMEOUT_SECONDS=5
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_RATE_LIMIT_PER_MINUTE=30
