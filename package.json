{
  "name": "smart-admission",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "智慧入学信息公示平台",
  "scripts": {
    "dev": "vite",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:data": "node scripts/validate-data.mjs",
    "check:zones": "node scripts/check-zones.mjs",
    "repair:zones": "node scripts/repair-zones.mjs",
    "test:zones": "node --test \"scripts/tests/*.test.mjs\"",
    "check:release": "node scripts/check-release.mjs",
    "audit:roads": "node scripts/roads/audit.mjs",
    "build:intersections": "node scripts/build-intersections.mjs",
    "diagnose:junctions": "node scripts/junction-diagnose.mjs",
    "import:network": "node scripts/import-network.mjs",
    "network": "node scripts/network.mjs",
    "test:server": "python -m server.tests.test_app",
    "check": "npm run lint && npm run validate:data"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "vite": "^8.3.0"
  }
}
