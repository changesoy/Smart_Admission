{
  "name": "smart-admission",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "智慧入学信息公示平台",
  "scripts": {
    "dev": "vite",
    "ui": "vite --open /tools/index.html",
    "editor": "vite --open /tools/boundary-editor/index.html",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "cli": "node scripts/main.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:data": "node scripts/validate-data.mjs",
    "check:zones": "node scripts/check-zones.mjs",
    "repair:zones": "node scripts/repair-zones.mjs",
    "test:zones": "node --test \"scripts/tests/*.test.mjs\"",
    "check:release": "node scripts/check-release.mjs",
    "audit:roads": "node scripts/roads/audit.mjs",
    "build:intersections": "node scripts/build-intersections.mjs",
    "diagnose:junctions": "node scripts/junction-diagnose.mjs",
    "import:network": "node scripts/import-network.mjs",
    "network": "node scripts/network.mjs",
    "migrate:features": "node scripts/migrate-boundary-features.mjs",
    "migrate:zone-specs": "node scripts/migrate-zone-specs-v2.mjs",
    "validate:network": "node scripts/validate-network.mjs",
    "generate:network": "node scripts/generate-network.mjs",
    "candidates:network": "node scripts/build-connection-candidates.mjs",
    "validate:draft": "node scripts/validate-zone-draft.mjs",
    "import:draft": "node scripts/import-zone-draft.mjs",
    "export:network-refs": "node scripts/export-network-refs.mjs",
    "test:server": "python -m server.tests.test_app",
    "check": "npm run lint && npm run validate:data"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "vite": "^8.3.0"
  }
}
